# Build-time hot set sweep base for XIndex/YCSB.
# Source this through:
#   ARBITER_XINDEX_EXPERIMENT=hotset \
#   ARBITER_HOTSET_CONFIG=configs/hotset/xindex-sweep-base.config \
#   ./scripts/build-xindex-llvm.sh

ARBITER_HOTSET_MIN_SCORE=6
ARBITER_HOTSET_SEED_LIMIT=3
ARBITER_HOTSET_SEED_SITE_IDS=
ARBITER_HOTSET_EXPANSION=use
ARBITER_HOTSET_MAX_SITES=16
ARBITER_HOTSET_INCLUDE_MMAP=0
ARBITER_HOTSET_PLACEMENT=target
ARBITER_HOTSET_TARGET_NODE=1

# Point weights. These defaults preserve the original scorer.
ARBITER_HOTSET_WEIGHT_ESCAPE_RETURN=3
ARBITER_HOTSET_WEIGHT_ESCAPE_STORE=3
ARBITER_HOTSET_WEIGHT_ESCAPE_CALL=2
ARBITER_HOTSET_WEIGHT_SYNC_ATOMIC=3
ARBITER_HOTSET_WEIGHT_SYNC_STORE=2
ARBITER_HOTSET_WEIGHT_SYNC_INLINE_ASM=2
ARBITER_HOTSET_WEIGHT_SYNC_FILE=1
ARBITER_HOTSET_WEIGHT_WORKER_ENTRY=3
ARBITER_HOTSET_WEIGHT_WORKER_REACHABLE=2
ARBITER_HOTSET_WEIGHT_SIZE=1

# Automatic seed gates.
ARBITER_HOTSET_REQUIRE_ESCAPE=1
ARBITER_HOTSET_REQUIRE_SYNC=1

# Static size scoring and byte-budget estimates.
ARBITER_HOTSET_LARGE_ALLOCATION_THRESHOLD=4096
ARBITER_HOTSET_INCLUDE_DYNAMIC_SIZE=1
ARBITER_HOTSET_DYNAMIC_SIZE_ESTIMATE=4096
ARBITER_HOTSET_MAX_ESTIMATED_BYTES=0
ARBITER_HOTSET_MAX_MEMBERS_PER_SEED=4

# Read/write-coupled member affinity and bounded static traversal.
ARBITER_HOTSET_MEMBER_MIN_AFFINITY=3
ARBITER_HOTSET_MEMBER_MAX_CALL_DEPTH=1
ARBITER_HOTSET_MEMBER_MAX_LOAD_DEPTH=2
