# XIndex/YCSB hot-set root used by the NUMA slab/arena experiment.
#
# Site 99 is the fixed 96-byte AltBtreeBuffer allocation in put() for the
# matching XIndex build. Keep only the root: the formerly selected 8-byte
# member is vector reserve bookkeeping and costs a separate placement page
# with the legacy direct NUMA backend.

ARBITER_HITM_MIN_SCORE=13
ARBITER_HITM_SEED_LIMIT=1
ARBITER_HITM_SEED_SITE_IDS=99
ARBITER_HITM_INCLUDE_DYNAMIC_SIZE=0

# Driver-side fail-closed identity checks. Explicit IDs are build-specific.
ARBITER_HOTSET_EXPECTED_SEED_FUNCTION=put
ARBITER_HOTSET_EXPECTED_SEED_COUNT=1
ARBITER_HOTSET_EXPECTED_MEMBER_COUNT=0

ARBITER_HOTSET_EXPANSION=none
ARBITER_HOTSET_MEMBER_MIN_AFFINITY=5
ARBITER_HOTSET_MEMBER_MAX_CALL_DEPTH=1
ARBITER_HOTSET_MEMBER_MAX_LOAD_DEPTH=2
ARBITER_HOTSET_MAX_MEMBERS_PER_SEED=1
ARBITER_HOTSET_MAX_SITES=1
ARBITER_HOTSET_DYNAMIC_SIZE_ESTIMATE=4096
ARBITER_HOTSET_MAX_ESTIMATED_BYTES=1024
ARBITER_HOTSET_INCLUDE_MMAP=0
