# Default automatic fixed-size arena policy. The previous site-99 pin is kept
# only in xindex-cxl-arena-site99-baseline.config for reproduction.

ARBITER_HITM_MIN_SCORE=13
ARBITER_HITM_SEED_LIMIT=1
ARBITER_HITM_SEED_SITE_IDS=
ARBITER_HITM_INCLUDE_DYNAMIC_SIZE=0

# Driver-side fail-closed count checks. Resolved IDs remain build-specific and
# are retained in hotset-sites.csv rather than encoded as policy inputs.
ARBITER_HOTSET_EXPECTED_SEED_COUNT=1

ARBITER_HOTSET_DYNAMIC_SIZE_ESTIMATE=4096
ARBITER_HOTSET_MAX_ESTIMATED_BYTES=1024
