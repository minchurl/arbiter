# Conservative XIndex/YCSB hot set for an initial CXL placement run.
#
# The sweep base selects three seeds and four members. At runtime, those sites
# can execute many times, and each tiny numa_alloc_onnode allocation consumes
# at least one page. Keep one high-confidence seed/member pair until dynamic
# allocation counts and live-byte profiles are available.

# Sites 97 (insert_ptr) and 99 (put) tie at score 14 in the matching XIndex
# build. The automatic top-1 tie-break chooses insert_ptr, which the 1M/4M
# pilot showed to be a very high-frequency training/maintenance allocation.
# Pin the workload update-path root instead. The driver retains the matching
# decision CSV and binary hash because explicit IDs are build-specific.
ARBITER_HITM_MIN_SCORE=13
ARBITER_HITM_SEED_LIMIT=1
ARBITER_HITM_SEED_SITE_IDS=99
ARBITER_HITM_INCLUDE_DYNAMIC_SIZE=0

# Driver-side fail-closed checks. These are advisory metadata and are not
# translated into LLVM options by scripts/xindex-experiments/hotset.sh.
ARBITER_HOTSET_EXPECTED_SEED_FUNCTION=put
ARBITER_HOTSET_EXPECTED_SEED_COUNT=1
ARBITER_HOTSET_EXPECTED_MEMBER_COUNT=1

# Add at most one write-coupled member. The 1 KiB static budget admits the
# fixed-size 96-byte seed and 8-byte member but rejects a dynamically sized
# member, which is charged ARBITER_HOTSET_DYNAMIC_SIZE_ESTIMATE bytes.
ARBITER_HOTSET_EXPANSION=use
ARBITER_HOTSET_MEMBER_MIN_AFFINITY=5
ARBITER_HOTSET_MEMBER_MAX_CALL_DEPTH=1
ARBITER_HOTSET_MEMBER_MAX_LOAD_DEPTH=2
ARBITER_HOTSET_MAX_MEMBERS_PER_SEED=1
ARBITER_HOTSET_MAX_SITES=2
ARBITER_HOTSET_DYNAMIC_SIZE_ESTIMATE=4096
ARBITER_HOTSET_MAX_ESTIMATED_BYTES=1024
ARBITER_HOTSET_INCLUDE_MMAP=0
