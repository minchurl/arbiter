# HITM-risk hypothesis emphasizing publication into shared structures.
# Storing the allocation-derived pointer and worker reachability receive two
# points.  Other evidence receives one point, including fixed size as a weak
# tie breaker that excludes otherwise identical dynamic helper allocations.
ARBITER_HITM_MIN_SCORE=6
ARBITER_HITM_SEED_LIMIT=12
ARBITER_HITM_SEED_SITE_IDS=
ARBITER_HITM_WEIGHT_ESCAPE_RETURN=1
ARBITER_HITM_WEIGHT_ESCAPE_STORE=2
ARBITER_HITM_WEIGHT_ESCAPE_CALL=1
ARBITER_HITM_WEIGHT_SYNC_ATOMIC=1
ARBITER_HITM_WEIGHT_SYNC_STORE=1
ARBITER_HITM_WEIGHT_SYNC_INLINE_ASM=1
ARBITER_HITM_WEIGHT_SYNC_FILE=1
ARBITER_HITM_WEIGHT_WORKER_ENTRY=1
ARBITER_HITM_WEIGHT_WORKER_REACHABLE=2
ARBITER_HITM_WEIGHT_SIZE=1
ARBITER_HITM_REQUIRE_ESCAPE=1
ARBITER_HITM_REQUIRE_SYNC=1
ARBITER_HITM_LARGE_ALLOCATION_THRESHOLD=128
ARBITER_HITM_INCLUDE_DYNAMIC_SIZE=0
ARBITER_HITM_SEED_EXPECTED_COUNT=
ARBITER_HITM_SEED_DYNAMIC_SIZE_ESTIMATE=4096
ARBITER_HITM_SEED_MAX_ESTIMATED_BYTES=0
