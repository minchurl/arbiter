# Conservative bridge from raw-046 to a general HITM-risk policy.
#
# Escape, synchronization/mutation, and worker evidence use the compiler's
# balanced defaults.  Size contributes only one point, so it cannot dominate
# the decision as it did in raw-046 (+6); it only distinguishes fixed 520-byte
# sites such as 71/74 from otherwise identical dynamic helper allocations.
# Sites 68 and 71 both pass on XIndex without explicit site IDs.
ARBITER_HITM_MIN_SCORE=8
ARBITER_HITM_SEED_LIMIT=12
ARBITER_HITM_SEED_SITE_IDS=
ARBITER_HITM_WEIGHT_ESCAPE_RETURN=3
ARBITER_HITM_WEIGHT_ESCAPE_STORE=3
ARBITER_HITM_WEIGHT_ESCAPE_CALL=2
ARBITER_HITM_WEIGHT_SYNC_ATOMIC=3
ARBITER_HITM_WEIGHT_SYNC_STORE=2
ARBITER_HITM_WEIGHT_SYNC_INLINE_ASM=2
ARBITER_HITM_WEIGHT_SYNC_FILE=1
ARBITER_HITM_WEIGHT_WORKER_ENTRY=3
ARBITER_HITM_WEIGHT_WORKER_REACHABLE=2
ARBITER_HITM_WEIGHT_SIZE=1
ARBITER_HITM_REQUIRE_ESCAPE=1
ARBITER_HITM_REQUIRE_SYNC=1
ARBITER_HITM_LARGE_ALLOCATION_THRESHOLD=128
ARBITER_HITM_INCLUDE_DYNAMIC_SIZE=0
ARBITER_HITM_SEED_EXPECTED_COUNT=
ARBITER_HITM_SEED_DYNAMIC_SIZE_ESTIMATE=4096
ARBITER_HITM_SEED_MAX_ESTIMATED_BYTES=0
