# Site-71-only causal ablation derived from raw-046.
#
# This config intentionally pins the XIndex collision B-tree leaf allocation
# site. It tests whether site 71 drives the raw-046 result; it is not an
# automatic or workload-general selection policy.
ARBITER_HITM_MIN_SCORE=7
ARBITER_HITM_SEED_LIMIT=1
ARBITER_HITM_SEED_SITE_IDS=71
ARBITER_HITM_WEIGHT_ESCAPE_RETURN=2
ARBITER_HITM_WEIGHT_ESCAPE_STORE=2
ARBITER_HITM_WEIGHT_ESCAPE_CALL=1
ARBITER_HITM_WEIGHT_SYNC_ATOMIC=2
ARBITER_HITM_WEIGHT_SYNC_STORE=1
ARBITER_HITM_WEIGHT_SYNC_INLINE_ASM=1
ARBITER_HITM_WEIGHT_SYNC_FILE=1
ARBITER_HITM_WEIGHT_WORKER_ENTRY=2
ARBITER_HITM_WEIGHT_WORKER_REACHABLE=1
# Object size must not influence this causal test.
ARBITER_HITM_WEIGHT_SIZE=0
ARBITER_HITM_REQUIRE_ESCAPE=1
ARBITER_HITM_REQUIRE_SYNC=1
ARBITER_HITM_LARGE_ALLOCATION_THRESHOLD=128
ARBITER_HITM_INCLUDE_DYNAMIC_SIZE=0
ARBITER_HITM_SEED_EXPECTED_COUNT=1
ARBITER_HITM_SEED_DYNAMIC_SIZE_ESTIMATE=4096
ARBITER_HITM_SEED_MAX_ESTIMATED_BYTES=0
