# Reproduction-only reference for the matching XIndex build.
# Site 99 is the fixed 96-byte AltBtreeBuffer allocation in put().

ARBITER_HITM_MIN_SCORE=13
ARBITER_HITM_SEED_LIMIT=1
ARBITER_HITM_SEED_SITE_IDS=99
ARBITER_HITM_INCLUDE_DYNAMIC_SIZE=0

ARBITER_HITM_SEED_EXPECTED_FUNCTION=put
ARBITER_HITM_SEED_EXPECTED_COUNT=1

ARBITER_HITM_SEED_DYNAMIC_SIZE_ESTIMATE=4096
ARBITER_HITM_SEED_MAX_ESTIMATED_BYTES=1024
