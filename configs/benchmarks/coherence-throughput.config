# Source from the repository root before building the coherence microbenchmark.
# Historical layout preset. Published-RMW selection was retired; this policy
# does not promise the historical table-only selection or performance.
export ARBITER_HITM_SEED_CONFIG="$PWD/configs/hitm-seed/policy-candidates/evidence-balanced-size-tiebreaker.config"
export ARBITER_BENCH_BUILD_DIR="$PWD/build/arbiter-bench/coherence-throughput"
export ARBITER_MICRO_ENTRY_BYTES=64
export ARBITER_MICRO_EPOCH_STORE=1
