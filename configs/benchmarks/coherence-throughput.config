# Source from the repository root before building the coherence microbenchmark.
# Measured layout/epoch improvement; CXL placement alone was neutral.
export ARBITER_BENCH_SELECTION=policy
export ARBITER_HITM_SEED_CONFIG="$PWD/configs/hitm-seed/policy-candidates/published-rmw-size-tiebreaker.config"
export ARBITER_BENCH_BUILD_DIR="$PWD/build/arbiter-bench/coherence-throughput"
export ARBITER_MICRO_ENTRY_BYTES=64
export ARBITER_MICRO_EPOCH_STORE=1
export ARBITER_MICRO_FAST_INDEX=0
