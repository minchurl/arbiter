ARBITER_HITM_SEED_LIMIT=1
ARBITER_HITM_SEED_SITE_IDS=
ARBITER_HITM_INCLUDE_DYNAMIC_SIZE=0
ARBITER_HOTSET_EXPECTED_SEED_COUNT=1
ARBITER_HOTSET_EXPECTED_MEMBER_COUNT=0
ARBITER_HOTSET_EXPANSION=none
ARBITER_HOTSET_MAX_MEMBERS_PER_SEED=1
ARBITER_HOTSET_MAX_SITES=1
ARBITER_HOTSET_MAX_ESTIMATED_BYTES=1024
ARBITER_HOTSET_INCLUDE_MMAP=0

