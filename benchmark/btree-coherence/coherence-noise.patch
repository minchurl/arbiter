+static size_t parse_number(const char* value) {
+    char* end = nullptr;
+    errno = 0;
+    unsigned long long n = std::strtoull(value, &end, 10);
+    if (!*value || *value == '-' || errno || *end || n > std::numeric_limits<size_t>::max()) {
+        fprintf(stderr, "invalid non-negative integer: %s\n", value);
+        std::exit(1);
+    }
+    return static_cast<size_t>(n);
+}
+static int parse_int(const char* value) {
+    size_t n = parse_number(value);
+    if (n > std::numeric_limits<int>::max()) std::exit(1);
+    return static_cast<int>(n);
+}
