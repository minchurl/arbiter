+#include "page-sample.h"
+#ifdef ARBITER_BTREE_NODE_ARRAYS
+#include "arbiter_runtime_site.h"
+// Only the two persistent arrays in make_node use the bound arena.
+static void *allocate_node_array(size_t bytes, uint32_t site) {
+    void *p = arbiter_calloc_site(1, bytes, 64, site, 0);
+    if (!p) {
+        fprintf(stderr, "B-tree arena allocation failed at site %u\n", site);
+        exit(EXIT_FAILURE);
+    }
+    allocator_stat += bytes;
+    return p;
+}
+#define free(ptr) arbiter_free_maybe(ptr)
+#else
+#define allocate_node_array(bytes, site) allocate_align64(bytes)
+#endif
 
